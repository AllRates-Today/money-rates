{
  "name": "money-rates",
  "version": "1.0.0",
  "description": "money.js-compatible currency conversion with live rates built in. Same fx(100).from('USD').to('GBP') API, plus fx.load() for keyless ECB rates or real-time mid-market rates for 160+ currencies from AllRatesToday.",
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    }
  },
